<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>STL to STEP</name>
  <description>FreeCAD workbench integrating the stl2step reconstruction engine. On first use it asks before downloading the pinned, SHA-256-verified engine from GitHub (Windows x64 only).</description>
  <version>0.6.0</version>
  <date>2026-10-16</date>
  <freecadmin>1.0.0</freecadmin>
  <maintainer email="cdracars@gmail.com">Cody Dracars</maintainer>
  <author>Cody Dracars</author>
  <license file="LICENSE">MIT</license>
  <url type="repository" branch="main">https://github.com/cdracars/stl2step-freecad</url>
  <url type="bugtracker">https://github.com/cdracars/stl2step-freecad/issues</url>
  <url type="readme">https://raw.githubusercontent.com/cdracars/stl2step-freecad/main/README.md</url>
  <icon>freecad/stl2step/resources/icons/stl2step.svg</icon>
  <tag>mesh</tag>
  <tag>STL</tag>
  <tag>STEP</tag>
  <content>
    <workbench>
      <classname>Stl2StepWorkbench</classname>
      <description>Convert meshes into STEP B-Rep geometry with stl2step.</description>
      <subdirectory>./</subdirectory>
      <icon>freecad/stl2step/resources/icons/stl2step.svg</icon>
    </workbench>
  </content>
</package>
